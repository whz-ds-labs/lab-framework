{
  "name": "%%course%%",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:py": "node scripts/run-golden.mjs",
    "golden": "node scripts/run-golden.mjs --make",
    "test:e2e": "playwright test",
    "lint:css": "stylelint --allow-empty-input \"site/**/*.{css,vue}\" \"labs/**/*.{css,vue}\"",
    "guard": "node scripts/check-no-materials.mjs",
    "changed-labs": "node scripts/changed-labs.mjs"
  },
  "dependencies": {
    "@whz-ds-labs/lab-kit": "%%frameworkVersion%%",
    "@whz-ds-labs/ui": "%%frameworkVersion%%",
    "d3-scale": "4.0.3",
    "katex": "0.19.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "postcss": "8.5.32",
    "postcss-html": "2.0.0",
    "stylelint": "18.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
