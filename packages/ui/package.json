{
  "name": "@whz-ds-labs/ui",
  "version": "0.0.0",
  "description": "Design tokens, base styles and Vue components for DS Labs teaching tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whz-ds-labs/lab-framework.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@whz-ds-labs/lab-kit": "0.0.0"
  },
  "peerDependencies": {
    "d3-scale": "^4.0.2",
    "katex": "^0.19.0",
    "vue": "^3.5.0"
  }
}
